# pibot needs no keys: every person signs in with ChatGPT, and their agents run on their subscription.

# Optional overrides
# PORT=8787
# DATA_DIR=./data                  # app.sqlite (people, sessions, tokens) and one pi-durable database per person
# MODEL_ID=gpt-6.1-sol             # the OpenAI model new agents start with

# Meta Ads connector: the App ID of a Meta app with the "Create & manage ads with ads MCP server" use case.
# Add http://localhost:8787/api/connectors/oauth/callback to its Facebook Login for Business redirect URIs.
# META_APP_ID=
# PUBLIC_URL=http://localhost:8787   # this server as the browser reaches it: OAuth callbacks, inbound connector URLs
